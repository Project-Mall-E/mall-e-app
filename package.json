{
  "name": "mall-e-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk && adb shell am start -n com.yourcompany.malle/.MainActivity",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prepare": "lefthook install",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "validate:hooks": "lefthook run pre-commit --all-files",
    "lint": "expo lint",
    "lint:eslint:fix": "eslint --fix",
    "update:agent-skills": "./scripts/sync-react-native-skills.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.0.10",
    "@react-navigation/native-stack": "^7.2.0",
    "@supabase/supabase-js": "^2.99.1",
    "expo": "~55.0.0",
    "expo-build-properties": "~55.0.9",
    "expo-dev-client": "~55.0.16",
    "expo-image": "^55.0.6",
    "expo-linear-gradient": "~55.0.8",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "cspell": "^9.7.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "eslint-plugin-react": "^7.37.5",
    "lefthook": "^2.1.4",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}