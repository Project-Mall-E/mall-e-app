{
  "expo": {
    "scheme": "com.celestialdragonfly.malle",
    "plugins": [
      ["expo-build-properties", { "ios": { "deploymentTarget": "15.1" } }]
    ],
    "name": "Mall-E",
    "slug": "mall-e-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.malle"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.yourcompany.malle"
    },
    "web": {
      "bundler": "metro"
    }
  }
}